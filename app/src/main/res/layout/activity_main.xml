<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    tools:context=".MainActivity">

    <ScrollView
        android:id="@+id/desplazamiento_catalogo"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/txv_titulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:accessibilityHeading="true"
                android:text="@string/catalogo_titulo"
                android:textAppearance="?attr/textAppearanceHeadlineMedium"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tarjeta_2048"
                style="@style/TarjetaCatalogo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/catalogo_ocre">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <com.google.android.material.textview.MaterialTextView
                        style="@style/NombreJuegoCatalogo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/juego_2048" />

                    <com.google.android.material.textview.MaterialTextView
                        style="@style/DescripcionJuegoCatalogo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/catalogo_descripcion_2048" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_jugar_2048"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:contentDescription="@string/catalogo_jugar_2048"
                        android:text="@string/catalogo_jugar" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tarjeta_buscaminas"
                style="@style/TarjetaCatalogo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/catalogo_verde_azulado">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <com.google.android.material.textview.MaterialTextView
                        style="@style/NombreJuegoCatalogo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/juego_buscaminas" />

                    <com.google.android.material.textview.MaterialTextView
                        style="@style/DescripcionJuegoCatalogo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/catalogo_descripcion_buscaminas" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_jugar_buscaminas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:contentDescription="@string/catalogo_jugar_buscaminas"
                        android:text="@string/catalogo_jugar" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tarjeta_kenken"
                style="@style/TarjetaCatalogo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/catalogo_lavanda">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <com.google.android.material.textview.MaterialTextView
                        style="@style/NombreJuegoCatalogo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/juego_kenken" />

                    <com.google.android.material.textview.MaterialTextView
                        style="@style/DescripcionJuegoCatalogo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/catalogo_descripcion_kenken" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_jugar_kenken"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:contentDescription="@string/catalogo_jugar_kenken"
                        android:text="@string/catalogo_jugar" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
