<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <com.example.arcadia.juegos.kenken.ControlesKenKenView
        android:id="@+id/controles"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginBottom="8dp" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/comprobar"
        style="@style/Widget.Arcadia.BotonComprobarKenKen"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/kenken_comprobar"
        app:icon="@drawable/kenken_comprobar" />
</LinearLayout>
