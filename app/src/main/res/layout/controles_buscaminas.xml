<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingVertical="6dp">
    <TextView android:id="@+id/minas_restantes" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:gravity="center" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/arcade_ink" />
    <com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/modo" android:layout_width="wrap_content" android:layout_height="56dp" app:singleSelection="true" app:selectionRequired="true" app:checkedButton="@id/descubrir">
        <com.google.android.material.button.MaterialButton android:id="@+id/descubrir" style="?attr/materialButtonOutlinedStyle" android:layout_width="64dp" android:layout_height="match_parent" android:minWidth="48dp" android:padding="0dp" android:text="⛏" android:textSize="26sp" app:cornerRadius="8dp" app:backgroundTint="@color/minas_selector" android:textColor="@color/minas_selector_tinta" android:contentDescription="@string/minas_descubrir" />
        <com.google.android.material.button.MaterialButton android:id="@+id/marcar" style="?attr/materialButtonOutlinedStyle" android:layout_width="64dp" android:layout_height="match_parent" android:minWidth="48dp" android:padding="0dp" android:text="⚑" android:textSize="26sp" app:cornerRadius="8dp" app:backgroundTint="@color/minas_selector" android:textColor="@color/minas_selector_tinta" android:contentDescription="@string/minas_marcar" />
    </com.google.android.material.button.MaterialButtonToggleGroup>
    <com.google.android.material.button.MaterialButton android:id="@+id/pista" style="@style/Widget.Material3.Button.TextButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="56dp" android:minWidth="48dp" android:padding="0dp" android:text="💡" android:textSize="26sp" android:contentDescription="@string/minas_pista" />
</LinearLayout>
