<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
    <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:minLines="2" android:maxLines="2" android:textSize="21sp" android:textStyle="bold" android:fontFamily="sans-serif-black"/>
    <View android:id="@+id/accent" android:layout_width="52dp" android:layout_height="4dp" android:layout_marginTop="6dp"/>
    <com.example.arcadia.arcade.PortadaJuegoView android:id="@+id/art" android:layout_width="match_parent" android:layout_height="140dp" android:importantForAccessibility="no"/>
    <TextView android:id="@+id/play" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/arcade_play" android:textSize="12sp" android:letterSpacing="0.1" android:textStyle="bold"/>
</LinearLayout>
