<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:paddingHorizontal="16dp"
    android:gravity="center_vertical">
    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/back"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:padding="14dp"
        android:background="@drawable/arcade_icon_button"
        android:src="@drawable/arcade_back"
        android:contentDescription="@string/arcade_back" />
    <TextView
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:text="@string/arcade_brand"
        android:gravity="center"
        android:textSize="13sp"
        android:letterSpacing="0.2"
        android:textStyle="bold"
        android:textColor="@color/arcade_muted" />
    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/restart"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:padding="13dp"
        android:background="@drawable/arcade_icon_button"
        android:src="@drawable/arcade_restart"
        android:contentDescription="@string/arcade_restart" />
</LinearLayout>
