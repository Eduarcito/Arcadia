<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/arcade_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/arcade_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:paddingHorizontal="16dp" android:gravity="center_vertical">
        <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/back" android:layout_width="48dp" android:layout_height="48dp" android:padding="14dp" android:background="@drawable/arcade_icon_button" android:src="@drawable/arcade_back" android:contentDescription="@string/arcade_back"/>
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/arcade_brand" android:gravity="center" android:textSize="13sp" android:letterSpacing="0.2" android:textStyle="bold" android:textColor="@color/arcade_muted"/>
        <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/restart" android:layout_width="48dp" android:layout_height="48dp" android:padding="13dp" android:background="@drawable/arcade_icon_button" android:src="@drawable/arcade_restart" android:contentDescription="@string/arcade_restart"/>
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
            <TextView android:id="@+id/hero_caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="10sp" android:letterSpacing="0.16" android:textStyle="bold" android:textColor="@color/arcade_muted"/>
            <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:layout_marginBottom="20dp" android:textSize="38sp" android:fontFamily="sans-serif-black" android:textStyle="bold" android:textColor="@color/arcade_ink"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView android:id="@+id/stat_left" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:padding="18dp" android:textSize="27sp" android:textStyle="bold" android:textColor="@color/arcade_ink"/>
                <TextView android:id="@+id/stat_right" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:padding="18dp" android:textSize="27sp" android:textStyle="bold" android:textColor="@color/arcade_ink"/>
            </LinearLayout>
            <TextView android:id="@+id/gesture_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginVertical="18dp" android:gravity="center" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/arcade_muted"/>
            <com.example.arcadia.arcade.TableroArcadeView android:id="@+id/board" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center_horizontal"/>
            <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="58dp" android:paddingVertical="16dp" android:gravity="center" android:accessibilityLiveRegion="polite" android:textColor="@color/arcade_ink" android:textSize="14sp"/>
            <LinearLayout android:id="@+id/controls" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
            <LinearLayout android:id="@+id/instruction_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:padding="18dp" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/arcade_how_to_play" android:textSize="11sp" android:letterSpacing="0.12" android:textStyle="bold" android:textColor="@color/arcade_muted"/>
                <TextView android:id="@+id/instructions" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textSize="14sp" android:lineSpacingExtra="3dp" android:textColor="@color/arcade_muted"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>