<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/arcade_bg">
    <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/back" android:layout_width="48dp" android:layout_height="48dp" android:padding="14dp" android:layout_margin="8dp"
        android:background="@drawable/arcade_icon_button" android:src="@drawable/arcade_back" android:contentDescription="@string/arcade_back"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"/>
    <ScrollView android:layout_width="0dp" android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/back" app:layout_constraintBottom_toBottomOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout android:id="@+id/options" android:layout_width="0dp" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintWidth_max="@dimen/ancho_contenido_max"  android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
            <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/arcade_settings" android:textColor="@color/arcade_ink" android:textSize="36sp" android:textStyle="bold"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="28dp" android:text="@string/arcade_settings_caption" android:textColor="@color/arcade_muted" android:textSize="16sp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/arcade_volume" android:textColor="@color/arcade_ink" android:textSize="21sp"/>
                <TextView android:id="@+id/volume_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/arcade_muted" android:textSize="16sp"/>
            </LinearLayout>
            <com.google.android.material.slider.Slider android:id="@+id/volume"
                android:layout_width="match_parent" android:layout_height="64dp"
                android:contentDescription="@string/arcade_volume"
                android:valueFrom="0" android:valueTo="100" android:stepSize="1" android:value="45" app:thumbRadius="14dp" app:trackHeight="8dp" app:tickVisible="false"/>
            <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/sound"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="76dp"
                android:text="@string/arcade_sound" android:textColor="@color/arcade_ink" android:textSize="23sp"/>
            <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/music"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="76dp"
                android:text="@string/arcade_music" android:textColor="@color/arcade_ink" android:textSize="23sp"/>
            <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/vibration"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="76dp"
                android:text="@string/arcade_vibration" android:textColor="@color/arcade_ink" android:textSize="23sp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp"
                android:text="@string/arcade_dark" android:textColor="@color/arcade_ink" android:textSize="21sp"/>
            <com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/theme"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp"
                app:singleSelection="true" app:selectionRequired="true">
                <com.google.android.material.button.MaterialButton android:id="@+id/theme_system" style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/arcade_theme_system"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/theme_light" style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/arcade_theme_light"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/theme_dark" style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/arcade_theme_dark"/>
            </com.google.android.material.button.MaterialButtonToggleGroup>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="24dp"
                android:text="@string/arcade_settings_note" android:textColor="@color/arcade_muted" android:textSize="14sp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/reset" style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/arcade_settings_reset"/>
        </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
