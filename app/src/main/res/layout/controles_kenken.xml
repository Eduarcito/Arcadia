<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:orientation="horizontal">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/numero1" style="@style/Widget.Arcadia.BotonTeclaKenKen"
        android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1"
        android:layout_marginEnd="4dp" android:text="1" android:textSize="24sp" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/numero2" style="@style/Widget.Arcadia.BotonTeclaKenKen"
        android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1"
        android:layout_marginHorizontal="4dp" android:text="2" android:textSize="24sp" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/numero3" style="@style/Widget.Arcadia.BotonTeclaKenKen"
        android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1"
        android:layout_marginHorizontal="4dp" android:text="3" android:textSize="24sp" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/numero4" style="@style/Widget.Arcadia.BotonTeclaKenKen"
        android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1"
        android:layout_marginHorizontal="4dp" android:text="4" android:textSize="24sp" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/borrar" style="@style/Widget.Arcadia.BotonTeclaKenKen"
        android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1"
        android:layout_marginStart="4dp"
        android:contentDescription="@string/kenken_borrar"
        app:icon="@drawable/kenken_borrar" app:iconGravity="textStart" />

</LinearLayout>
